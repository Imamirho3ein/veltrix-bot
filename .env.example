# -----------------------------------------------------------------------------
# VELTRIX STUDIO Telegram bot — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# -----------------------------------------------------------------------------

# Bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=""

# Numeric Telegram IDs allowed to use /admin. Separate with commas.
# Send /myid to the bot to get your own ID.
# Leave empty to let the first person who opens /admin become the owner.
ADMIN_TELEGRAM_IDS=""

# Channel used for new-order announcements and the mandatory join check.
# Use @username or the numeric -100... id. The bot must be an admin in the channel.
TELEGRAM_CHANNEL_ID="@VeeltrixStudio"

# Require users to join the channel before using the bot ("true"/"false").
FORCE_CHANNEL_JOIN="true"

# Optional local proxy if api.telegram.org is blocked on your network.
# HTTP:   http://127.0.0.1:10809
# SOCKS5: socks5://127.0.0.1:10808
TELEGRAM_API_PROXY=""

# Branding
BRAND_NAME="VELTRIX STUDIO"
SITE_URL="https://veltrixstudio.com"
TELEGRAM_CHANNEL_URL="https://t.me/VeltrixStudio"
TELEGRAM_SUPPORT_URL="https://t.me/VeltrixStudio"
INSTAGRAM_URL="https://instagram.com/veltrixstudio"
CONTACT_EMAIL="hello@veltrixstudio.com"
CONTACT_PHONE=""
